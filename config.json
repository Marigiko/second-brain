{
  "obsidian": {
    "vault_path": "/mnt/d/Documentos/Bovedas/Main",
    "vault_path_windows": "D:/Documentos/Bovedas/Main",
    "write_mode": "auto",
    "api_base_url": "https://127.0.0.1:27124",
    "api_key_env": "OBSIDIAN_API_KEY",
    "use_http_fallback": true,
    "http_url": "http://127.0.0.1:27123"
  },
  "vault": {
    "areas": {
      "proyectos": "Proyectos",
      "conocimiento": "Conocimiento",
      "archivo": "Archivo"
    },
    "moc": {
      "auto_create": true,
      "filename": {
        "proyectos": "00 - Mapa del Proyecto.md",
        "conocimiento": "00 - Mapa del dominio.md"
      }
    }
  },
  "routing": {
    "_comment": "Regla del vault (00 - Indice.md): si la nota deja de importar cuando el proyecto termina va a Proyectos; si sirve para el proximo trabajo parecido va a Conocimiento. Un agente no puede decidir eso por nota, asi que el default es SIEMPRE proyectos y Conocimiento es opt-in explicito, via knowledge_domain + knowledge_categories del proyecto.",
    "default_area": "proyectos",
    "categories": {
      "diario": {
        "subfolder": "Diario"
      },
      "decisiones": {
        "subfolder": "Decisiones"
      },
      "arquitectura": {
        "subfolder": "Arquitectura"
      },
      "aprendizajes": {
        "subfolder": "Aprendizajes"
      },
      "convenciones": {
        "subfolder": "Convenciones"
      }
    },
    "knowledge_inbox": "Bandeja de entrada",
    "_comment_inbox": "La taxonomia de un dominio de Conocimiento (Problemas/, Soluciones/, Paises/...) es CURADA A MANO y no se puede derivar de la categoria que usa el agente. Por eso todo lo que el sync manda a Conocimiento cae en una sola bandeja, para destilar despues. Asi el automatismo no contamina la estructura curada."
  },
  "sync": {
    "interval_minutes": 15,
    "retry_on_failure": true,
    "max_retries": 3
  },
  "refinement": {
    "interval_days": 3,
    "min_note_age_days": 7,
    "consolidate_threshold": 0.7
  },
